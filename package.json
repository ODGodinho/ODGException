{
    "name": "@odg/exception",
    "version": "0.0.1",
    "description": "Exception Class with preview for Js",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "homepage": "https://github.com/ODGodinho/ODGException",
    "repository": {
        "type": "git",
        "url": "https://github.com/ODGodinho/ODGException"
    },
    "bugs": {
        "url": "https://github.com/ODGodinho/ODGException/issues"
    },
    "scripts": {
        "build": "rimraf dist/ && tsc --project ./tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "build:watch": "npm run build && (concurrently \"tsc --project ./tsconfig.build.json -w\" \"tsc-alias -p tsconfig.build.json -w\")",
        "start": "node ./dist/index.ts",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "test": "vitest run",
        "test:ci": "vitest run --passWithNoTests",
        "test:watch": "vitest --watch"
    },
    "publishConfig": {
        "access": "public"
    },
    "release": {
        "branches": [
            "+([0-9])?(.{+([0-9]),x}).x",
            "main",
            "master",
            "next",
            "next-major",
            {
                "name": "beta",
                "prerelease": true
            },
            {
                "name": "alpha",
                "prerelease": true
            }
        ],
        "plugins": [
            "@semantic-release/commit-analyzer",
            "@semantic-release/release-notes-generator",
            "@semantic-release/npm",
            "@semantic-release/github"
        ]
    },
    "files": [
        "./dist/",
        "./README.md"
    ],
    "author": "Dragons Gamers <https://www.linkedin.com/in/victor-alves-odgodinho>",
    "license": "MIT",
    "devDependencies": {
        "@odg/eslint-config": "^3",
        "@odg/tsconfig": "*",
        "@types/node": ">=24",
        "@vitest/coverage-v8": "^4.0.18",
        "concurrently": "^9.2.1",
        "rimraf": "*",
        "tsc-alias": "^1.8.16",
        "typescript": "^5.9.3",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.0.18"
    }
}
